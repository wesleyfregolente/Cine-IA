        "# ============================================================\n",
        "# FUNÇÃO PARA CLASSIFICAR UMA MENSAGEM\n",
        "# ============================================================\n",
        "\n",
        "def predict_intent(message):\n",
        "\n",
        "    # Transformar a mensagem em array\n",
        "    message_array = np.array(\n",
        "        [message],\n",
        "        dtype=str\n",
        "    ).reshape(-1, 1)\n",
        "\n",
        "    # Converter para TensorFlow string\n",
        "    message_tensor = tf.convert_to_tensor(\n",
        "        message_array,\n",
        "        dtype=tf.string\n",
        "    )\n",
        "\n",
        "    # Fazer a previsão\n",
        "    prediction = model.predict(\n",
        "        message_tensor,\n",
        "        verbose=0\n",
        "    )\n",
        "\n",
        "    # Encontrar a classe com maior probabilidade\n",
        "    predicted_class = np.argmax(\n",
        "        prediction[0]\n",
        "    )\n",
        "\n",
        "    # IMPORTANTE:\n",
        "    # Usar o mesmo LabelEncoder utilizado no treinamento\n",
        "    intent = label_encoder.classes_[\n",
        "        predicted_class\n",
        "    ]\n",
        "\n",
        "    # Obter a confiança\n",
        "    confidence = prediction[0][\n",
        "        predicted_class\n",
        "    ]\n",
        "\n",
        "    return intent, confidence\n"
      ],
